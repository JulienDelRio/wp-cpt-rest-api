{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Write(./**)",
      "Read(.././**)",
      "Write(.././**)",
      "Bash(mkdir *:.)",
      "Bash(ls *:.)",
      "Bash(cat *:.)",
      "Bash(pwd:.)",
      "Bash(find *:.)",
      "Bash(grep *:.)",
      "Bash(git status:.)",
      "Bash(git -C * status:.)",
      "Bash(git log:.)",
      "Bash(git -C * log:.)",
      "Bash(git log *:.)",
      "Bash(git -C * log *:.)",
      "Bash(git diff:.)",
      "Bash(git -C * diff)",
      "Bash(git diff *:.)",
      "Bash(git -C * diff *:.)",
      "Bash(git branch:.)",
      "Bash(git -C * branch:.)",
      "Bash(git branch *:.)",
      "Bash(git -C * branch *:.)",
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(npm run *:.)",
      "Bash(npm test:.)",
      "Bash(docker ps:.)",
      "Bash(docker logs *:.)"
    ],
    "ask": [
      "Bash(git push *:.)",
      "Bash(git pull *:.)",
      "Bash(git merge *:.)",
      "Bash(git rebase *:.)",
      "Bash(git reset *:.)",
      "Bash(git clean *:.)",
      "Bash(git checkout *:.)",
      "Bash(git switch *:.)",
      "Bash(rm *:.)",
      "Bash(rm -r *:.)",
      "Bash(rm -rf *:.)",
      "Bash(docker run *:.)",
      "Bash(docker-compose *:.)",
      "Bash(docker compose *:.)",
      "Bash(sudo *:.)",
      "Bash(chmod *:.)",
      "Bash(chown *:.)",
      "Bash(npm install *:.)",
      "Bash(pip install *:.)",
      "Bash(yarn *:.)",
      "Bash(pnpm *:.)",
      "Bash(node *:.)",
      "Bash(npx *:.)",
      "Write(.env*)",
      "Write(config/*.prod*)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(../**)",
      "Read(../**)"
    ],
    "deny": [
      "Bash(rm -rf /:.)",
      "Bash(rm -rf ~:.)"
    ]
  }
}
